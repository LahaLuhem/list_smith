# not `*`, so a listed folder ships whole.
/*

!/lib/
!/pubspec.yaml
!/README.md
!/CHANGELOG.md
!/LICENSE

# pub.dev's gallery, through pubspec.yaml's `screenshots:`.
!/doc/
/doc/*
!/doc/screenshots/

# pub.dev's Example tab.
!/example/
/example/*
!/example/lib/
!/example/pubspec.yaml
!/example/pubspec.lock
!/example/README.md
